{
    "name": "smaege/leclient",
    "type": "library",
    "description": "PHP LetsEncrypt client library for ACME v2",
    "license": "MIT",
    "keywords": [
        "letsencrypt",
        "acme",
        "acme-v2",
        "ssl",
        "tls",
        "certificate",
        "https"
    ],
    "authors": [
        {
            "name": "Youri van Weegberg",
            "email": "youri@yourivw.nl",
            "role": "Developer"
        },
        {
            "name": "Al Ganiev",
            "email": "helios.ag@gmail.com",
            "role": "Maintainer"
        },
        {
            "name": "Miikka Aho",
            "email": "miikka@finquteam.com",
            "role": "Maintainer"
        }
    ],
    "homepage": "https://github.com/smaege/LEClient",
    "support": {
        "issues": "https://github.com/smaege/LEClient/issues",
        "source": "https://github.com/smaege/LEClient"
    },
    "require": {
        "php": ">=8.1",
        "ext-openssl": "*",
        "ext-curl": "*"
    },
    "suggest": {
        "psr/log": "Required when using a PSR-3 logger with LEClient"
    },
    "autoload": {
        "psr-4": {
            "LEClient\\": "src/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "psr/log": "^1.1"
    },
    "autoload-dev": {
        "psr-4": {
            "LEClient\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --testsuite Unit && phpunit --testsuite Integration",
        "test:unit": "phpunit --testsuite Unit",
        "test:integration": "phpunit --testsuite Integration",
        "test:e2e": "phpunit --testsuite E2E",
        "test:all": [
            "@test",
            "@test:e2e"
        ],
        "docker:test-up": "docker compose -f docker-compose.test.yml up -d",
        "docker:test-down": "docker compose -f docker-compose.test.yml down"
    }
}
