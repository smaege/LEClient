{
    "name": "helios-ag/leclient",
    "type": "library",
    "description": "PHP LetsEncrypt client library for ACME v2",
    "license": "MIT",
    "version": "1.3.0",
    "require": {
        "php": ">=8.1",
        "ext-openssl": "*",
        "ext-curl": "*"
    },
    "autoload": {
        "psr-4": {
            "LEClient\\": "src/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "psr/log": "^1.1"
    },
    "autoload-dev": {
        "psr-4": {
            "LEClient\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --testsuite Unit && phpunit --testsuite Integration",
        "test:unit": "phpunit --testsuite Unit",
        "test:integration": "phpunit --testsuite Integration",
        "test:e2e": "phpunit --testsuite E2E",
        "test:all": [
            "@test",
            "@test:e2e"
        ],
        "docker:test-up": "docker compose -f docker-compose.test.yml up -d",
        "docker:test-down": "docker compose -f docker-compose.test.yml down"
    }
}
